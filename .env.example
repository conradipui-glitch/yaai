# Wordstat / Yandex Cloud Search API
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# Optional dedicated aliases for live Yandex Search API SERP collection
# Falls back to YANDEX_API_KEY / YANDEX_FOLDER_ID when empty
YANDEX_SEARCH_API_KEY=
YANDEX_SEARCH_FOLDER_ID=
# YouTube Data API v3 for explicit distribution research collection
YOUTUBE_API_KEY=
# Telegram MTProto research client (create app at my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Local session file produced by npm run telegram:auth; never commit it
TELEGRAM_SESSION_FILE=
# Yandex Webmaster API: distinct OAuth credential (do not reuse the Cloud API key)
YANDEX_WEBMASTER_OAUTH_TOKEN=
# Optional verified Webmaster site URL
YAAI_WEBMASTER_SITE=
YAAI_WORKSPACE=
# YAAI_CASE_ROOT=
CASE_ID=
PORT=8787
